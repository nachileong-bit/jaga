# Copy to .env (never commit .env)
PORT=3000

# --- WhatsApp through WAHA (optional; the web demo works without it) ---
WAHA_URL=https://your-waha.up.railway.app
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_WEBHOOK_SECRET=make-a-long-random-string
# Jaga replies ONLY to these chats. Comma separated. Example: 6591234567@c.us
JAGA_ALLOWED_CHATS=
# Optional second phone that plays the trusted person (Mei Ling)
JAGA_SUPPORT_CHAT=
# Public address of this server, used for the GP summary link
PUBLIC_BASE_URL=

# --- LLM for M3 (any OpenAI-compatible endpoint) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
