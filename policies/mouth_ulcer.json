    {
      "id": "ulcer_not_better_after_self_treatment",
      "when": {
        "minDurationDays": 7,
        "selfTreatment": true,
        "trajectoryIn": ["same", "worse", "intermittent"]
      },
      "action": "SEE_GP",
      "explain": "Your mouth ulcer has not improved after 7 days of gels or mouthwash. Please see a GP or dentist.",
      "sourceIndex": 0
    },
    {
      "id": "worsening",
      "when": { "trajectoryIn": ["worse"] },
      "action": "SEE_GP",
      "explain": "Your mouth ulcer is getting worse. Please see a GP or dentist.",
      "sourceIndex": 0
    }
